# ---------------------------------------------------------------- database
# Postgres, in development as well as production.
#
# Free tier that is enough for this shop: https://neon.tech (or Supabase).
# Create a project, copy the pooled connection string, paste it here.
# Two strings for the same database, and they are not interchangeable:
#
#   DATABASE_URL           the POOLED one (hostname contains "-pooler").
#                          Used by the site. Serverless hosting opens a
#                          connection per request and the pooler is what stops
#                          that exhausting the database.
#
#   DATABASE_URL_UNPOOLED  the DIRECT one (no "-pooler"). Used only by the
#                          Prisma CLI for schema changes, which need session
#                          state that the pooler does not have.
#
# Only DATABASE_URL needs to be set on your host. The unpooled one is for
# running `npm run setup` from your own machine.
#
# Use sslmode=verify-full, not the sslmode=require that Neon hands you.
# node-postgres currently treats "require" as "verify-full" anyway, but in
# pg v9 it changes to libpq semantics: encrypted, certificate NOT verified.
# Spelling it out means a future dependency bump cannot quietly downgrade the
# database connection to something a man in the middle can read.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# ---------------------------------------------------------------- auth
# Signing key for the session cookie. Must be long and random, and must be a
# DIFFERENT value in production than on your laptop.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ---------------------------------------------------------------- photographs
# Product photos are stored here rather than on the server's disk, because free
# hosting wipes its disk on every deploy. Free tier: https://cloudinary.com
# Leave all three blank to fall back to local public/uploads for development.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------- admin login
# Required before seeding any database that is not on your own machine.
# Seeding refuses to run without these, so the password published in this
# repository cannot end up on your live shop.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---------------------------------------------------------------- payments
# Leave blank to run with NO payment gateway: an order is recorded as PENDING /
# UNPAID and you settle it with the customer on WhatsApp. Nothing is ever
# marked paid without a real payment.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------- tax
# Sales tax as a fraction, applied to the subtotal. Left blank, no tax is
# charged and the line does not appear at checkout.
#
# Set this only if you are actually registered to collect it. 0.12 is 12%.
TAX_RATE=""

# ---------------------------------------------------------------- site
# Your live address once the domain is pointed at the host. Used to build
# absolute URLs, so it must be the real one in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
